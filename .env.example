# Copy this file to .env and fill in values. Do not commit real keys to GitHub.
# (The app can auto-create .env from this file only if .env is missing — prefer copying manually on a new machine.)
# Transcript API (conversational intelligence)
# .phenom.local hosts require VPN or internal DNS; override with reachable URLs if needed.
TRANSCRIPT_API_BASE_URL=http://mcs-campaign-execution-admin.prod.phenom.local
# If your CSV Link has no ?selectedEnv=..., set the same value the screening UI uses (e.g. produs, prodir).
TRANSCRIPT_SELECTED_ENV=

# Optional: JSON map to override hostnames per region if DNS differs (keys: produs, prodir, stgus, stgir).
# PHENOM_REGION_OVERRIDES={"prodir":{"transcript":"http://mcs-campaign-execution-admin.YOUR-HOST.phenom.local"}}
# Set to 1 to always use the four URLs below only (ignore selectedEnv for hosts).
# DISABLE_REGION_URL_RESOLUTION=

# SPX get-document (knowledge base)
SPX_TRANSFORMS_BASE_URL=http://spx-enterprise-search-transforms.prod.phenom.local

# SPX jobs (job details)
SPX_JOBS_BASE_URL=http://spx-jobs-service.prod.phenom.local

# JD_API_Needs: getMongoDocument (videoScreenId → jobSeqNo, locale, siteType for Job Description API)
JD_NEEDS_API_BASE_URL=http://mcs-campaign-execution-admin.stg.phenom.local

# X+ API (callId → jobId / jobSeqNo for job description; no CSV column)
XPLUS_API_BASE_URL=
XPLUS_API_KEY=


# Get a key from https://aistudio.google.com/apikey — never paste keys into .env.example
GEMINI_API_KEY=
# Optional: internal xplus-llm-gateway (recommended). If GEMINI_GATEWAY_BASE_URL is set, Run judge never uses Google GEMINI_API_KEY.
# GEMINI_GATEWAY_BASE_URL=http://xplus-llm-gateway.intqa.phenom.local
# GEMINI_GATEWAY_API_KEY=
# Retries for transient HTTP 502/503/504/429 and network errors (default 4 = up to 5 POSTs)
# GEMINI_GATEWAY_MAX_RETRIES=4
# Set to 0/false to never attach audio on gateway calls (smaller JSON; avoids many 502s on internal gateways)
# GEMINI_GATEWAY_SEND_AUDIO=false
# Default: audio sent as fileData.fileUri (link). Set to 1 to use legacy base64 inline_data instead.
# GEMINI_GATEWAY_AUDIO_INLINE=0
# Optional: force fileData.mimeType for every recording URL (e.g. video/mp4)
# GEMINI_GATEWAY_AUDIO_MIME=video/mp4
# file_data JSON keys: snake (default, Gemini/LiteLLM) or camel for custom gateways
# GEMINI_GATEWAY_FILE_DATA_CASE=snake
# Path segment before /<model>:generateContent (default matches internal gateway)
# GEMINI_GATEWAY_RESOURCE_PREFIX=v1beta/models/gemini
# GEMINI_JUDGE_TEMPERATURE=0.2
# Use a current model; gemini-1.5-flash is deprecated (404). See https://ai.google.dev/gemini-api/docs/models
GEMINI_JUDGE_MODEL=gemini-2.5-flash
